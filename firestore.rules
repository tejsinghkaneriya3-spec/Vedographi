rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStringList(listVal, maxSize) {
      return listVal is list &&
             listVal.size() <= maxSize &&
             (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 128));
    }

    function isValidUserProfile(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 120)) &&
             data.darkTheme is bool &&
             isValidStringList(data.favoriteFontIds, 300) &&
             isValidStringList(data.recentFontIds, 30);
    }

    function isValidCreation(data, userId) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 5000 &&
             data.kind is string &&
             data.kind in ['BIO', 'USERNAME', 'DECORATED', 'NAME', 'STATUS', 'OCCASION'];
    }

    // Per-user profile, favorite font IDs, recent font IDs, and theme sync
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll(['userId', 'darkTheme', 'favoriteFontIds', 'recentFontIds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'darkTheme', 'favoriteFontIds', 'recentFontIds', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming(), userId);

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming(), userId) &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['favoriteFontIds', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['recentFontIds', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['darkTheme', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'darkTheme', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'darkTheme', 'favoriteFontIds', 'recentFontIds', 'updatedAt'])
                       );

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      // Per-user saved Unicode creations in My Text Studio
      match /creations/{creationId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(creationId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(creationId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'kind', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'kind', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCreation(incoming(), userId);

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(creationId) &&
                         request.auth.uid == userId &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCreation(incoming(), userId) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'kind', 'updatedAt']);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(creationId) && request.auth.uid == userId;
      }
    }
  }
}
